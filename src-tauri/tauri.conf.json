{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSHarness",
  "version": "4.0.1",
  "identifier": "ai.deepseek.dsharness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "DSHarness", "width": 1320, "height": 840, "minWidth": 980, "minHeight": 640, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; frame-src http://127.0.0.1:* http://localhost:*" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/black-whale-centered.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "compression": "lzma"
      }
    }
  }
}
