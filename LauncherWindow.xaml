<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="DSH"
        Width="1040"
        Height="650"
        MinWidth="1040"
        MinHeight="650"
        MaxWidth="1040"
        MaxHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#F5F5F7" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceMuted" Color="#FAFAFC" />
        <SolidColorBrush x:Key="Border" Color="#E5E5EA" />
        <SolidColorBrush x:Key="TextPrimary" Color="#1D1D1F" />
        <SolidColorBrush x:Key="TextSecondary" Color="#6E6E73" />
        <SolidColorBrush x:Key="TextMuted" Color="#86868B" />
        <SolidColorBrush x:Key="Accent" Color="#0071E3" />
        <SolidColorBrush x:Key="AccentHover" Color="#0077ED" />
        <SolidColorBrush x:Key="AccentSoft" Color="#E8F2FF" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="#0068D1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1684EF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1684EF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#005FC1" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#005FC1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D1D6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAF3FC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6FA8DC" />
                                <Setter Property="Foreground" Value="#005FB8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCEAF7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2B8B5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FDE8E7" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D96A63" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F6D4D1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E5EDF6" />
                                <Setter Property="Foreground" Value="#0071E3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#526078" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBorder" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="#E5EDF6" />
                                <Setter Property="Foreground" Value="#1D1D1F" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Close" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ChromeBorder" Property="Background" Value="#FDECEB" />
                                <Setter Property="Foreground" Value="#B42318" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Margin="12" CornerRadius="12" Background="{StaticResource PageBackground}"
                BorderBrush="#E4E4E8" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.16" Color="#000000" />
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FBFBFD" BorderBrush="#E5E5EA" BorderThickness="0,0,0,1"
                        CornerRadius="12,12,0,0">
                    <Grid>
                        <Grid x:Name="DragArea" Background="Transparent" Margin="0,0,96,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                <Image x:Name="BrandIcon" Width="38" Height="38" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="DSH" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="DeepSeek Harness Launcher" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,8,8">
                            <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" Content="—" ToolTip="最小化" />
                            <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="×" Tag="Close" ToolTip="关闭到托盘" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="28,22,28,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,22,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Harness，随时就绪。" Foreground="{StaticResource TextPrimary}" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="启动、更新并管理本地 DeepSeek Harness。" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,7,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Margin="0,20,0,0" Padding="18" CornerRadius="18"
                                Background="{StaticResource Surface}" BorderBrush="#EBEBF0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.07" Color="#000000" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="StatusDot" Width="11" Height="11" CornerRadius="6"
                                            Background="#8A98AD" Margin="0,2,12,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="StatusTitle" Text="正在准备启动器"
                                                   Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock x:Name="StatusDetail" Text="正在检查本地运行环境"
                                                   Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock x:Name="ServiceStateLabel" Grid.Column="2" Text="正在检测"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                               FontWeight="SemiBold" VerticalAlignment="Top" Margin="16,1,0,0" />
                                </Grid>
                                <Border Grid.Row="1" Margin="0,15,0,12" Height="1" Background="#ECECF0" />
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⌁" Foreground="{StaticResource Accent}" FontSize="16" Margin="0,-2,8,0" />
                                        <TextBlock Text="http://127.0.0.1:3080" Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="Cascadia Mono,Consolas" FontSize="11.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Harness 版本  " Foreground="{StaticResource TextMuted}" FontSize="10" />
                                        <TextBlock x:Name="CommitLabel" Text="LOCAL" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="10" FontFamily="Cascadia Mono,Consolas" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenWebButton" Grid.Column="0" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OpenWebButtonIcon" Text="▶" FontSize="12" Margin="0,0,9,0" />
                                    <TextBlock x:Name="OpenWebButtonText" Text="启动 WebUI" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Grid.Column="1" Style="{StaticResource DangerButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="■" FontSize="11" Margin="0,0,7,0" />
                                    <TextBlock Text="停止" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RestartButton" Grid.Column="0" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↻" FontSize="16" Margin="0,0,7,0" />
                                    <TextBlock Text="重启" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⇄" FontSize="15" Margin="0,0,7,0" />
                                    <TextBlock Text="检查更新" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PluginManagerButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☷" FontSize="15" Margin="0,0,7,0" />
                                    <TextBlock Text="插件管理" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DiagnosticsButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" FontSize="15" Margin="0,0,7,0" />
                                    <TextBlock Text="系统诊断" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenFolderButton" Grid.Column="4" Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▱" FontSize="16" Margin="0,0,7,0" />
                                    <TextBlock Text="打开目录" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="4" Margin="0,16,0,0" Padding="16,13" CornerRadius="16"
                                Background="{StaticResource Surface}" BorderBrush="#EBEBF0" BorderThickness="1"
                                VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoft}">
                                    <TextBlock Text="⌂" Foreground="{StaticResource Accent}" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Harness 位置" Foreground="{StaticResource TextMuted}" FontSize="10.5" />
                                    <TextBlock x:Name="HarnessPathLabel" Text="正在读取…" Foreground="{StaticResource TextSecondary}"
                                               FontFamily="Cascadia Mono,Consolas" FontSize="10.5" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="306" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="20" Background="{StaticResource Surface}"
                                BorderBrush="#EBEBF0" BorderThickness="1" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.07" Color="#000000" />
                            </Border.Effect>
                            <Grid>
                                <Image x:Name="MaidImage" Width="255" Height="255" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Margin="0,14,0,0" Padding="16" CornerRadius="18"
                                Background="{StaticResource Surface}" BorderBrush="#EBEBF0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="运行信息" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" />
                                <Grid Grid.Row="1" Margin="0,13,0,0">
                                    <TextBlock Text="运行方式" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Text="本地运行" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <TextBlock Text="服务端口" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock x:Name="PortStateLabel" Text="3080 · 检测中" Foreground="{StaticResource TextPrimary}" FontSize="11"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                    <TextBlock Text="启动器版本" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                    <TextBlock Text="v2.0.0" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>
                        </Border>

                        
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="#FBFBFD" BorderBrush="#E5E5EA" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12">
                    <Grid Margin="22,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#22A06B" Margin="0,0,7,0" />
                            <TextBlock Text="本地运行环境" Foreground="{StaticResource TextMuted}" FontSize="9.5" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button x:Name="TerminalButton" Style="{StaticResource FooterButton}" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&gt;_" FontFamily="Cascadia Mono,Consolas" FontSize="11" Margin="0,0,7,0" />
                                <TextBlock x:Name="TerminalButtonText" Text="日志与终端" />
                                <TextBlock Text="⌃" FontSize="11" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <ProgressBar x:Name="ActivityProgress" Grid.Row="2" Height="2" Visibility="Collapsed"
                             VerticalAlignment="Top" Background="#E5E5EA" Foreground="{StaticResource Accent}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid Background="#E5E5EA" ClipToBounds="True">
                                <Rectangle Fill="{StaticResource Accent}" Width="160" HorizontalAlignment="Left">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="SlideTransform" X="-160" />
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="SlideTransform" Storyboard.TargetProperty="X"
                                                                     From="-160" To="1040" Duration="0:0:1.6" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>

                <Border x:Name="TerminalPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"
                        Height="260" Margin="28,0,28,48" VerticalAlignment="Bottom" Panel.ZIndex="20"
                        CornerRadius="16" Background="#08111F" BorderBrush="#304862" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.34" Color="#07101E" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#122238" CornerRadius="16,16,0,0" BorderBrush="#263C56" BorderThickness="0,0,0,1">
                            <Grid Margin="14,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="#FF6B72" Margin="0,0,6,0" />
                                    <Ellipse Width="7" Height="7" Fill="#F4C46E" Margin="0,0,6,0" />
                                    <Ellipse Width="7" Height="7" Fill="#58D69E" />
                                </StackPanel>
                                <TextBlock Text="日志与终端  ·  本地 HARNESS" Foreground="#7894B2"
                                           FontFamily="Cascadia Mono,Consolas" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBox x:Name="TerminalOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="#A9C4DA" BorderThickness="0"
                                 FontFamily="Cascadia Mono,Consolas" FontSize="11" Padding="14,10">
                            <TextBox.Resources>
                                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
                                <Style TargetType="{x:Type ScrollBar}">
                                    <Setter Property="Background" Value="#08111F" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,4">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                          Background="Transparent" Opacity="0" Focusable="False" />
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb MinHeight="24">
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                                        <Border x:Name="ThumbVisual" Background="#35506A" CornerRadius="3" />
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="ThumbVisual" Property="Background" Value="#4D6D8C" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsDragging" Value="True">
                                                                                <Setter TargetName="ThumbVisual" Property="Background" Value="#66DFFF" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                          Background="Transparent" Opacity="0" Focusable="False" />
                                                        </Track.IncreaseRepeatButton>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Grid Grid.Row="2" Margin="13,5,13,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PS &gt;" Foreground="#66DFFF" FontFamily="Cascadia Mono,Consolas"
                                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBox x:Name="TerminalInput" Grid.Column="1" Background="#101D2E" Foreground="#E7F2FF"
                                     BorderBrush="#2C4864" BorderThickness="1" Padding="8,4"
                                     FontFamily="Cascadia Mono,Consolas" FontSize="11.5" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
