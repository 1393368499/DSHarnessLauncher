# 上游 DSH 源码克隆（约 2GB，自带独立 .git，绝不入库）
/deepseek-harness/

# 本地开发 / 构建 / 备份资料
/backups/
/artifacts/
/plugin-fix/
/plugins/
/reports/
/.mimosa/
/_remote-check/
/build/bin/
/build/obj/
/DSH-LauncherHost.res
/DSH-LauncherHost.obj

# 一次性备份文件（*.bak）
*.bak

